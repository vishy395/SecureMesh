SECUREMESH_RUNTIME_DIR=runtime
SECUREMESH_DATABASE_PATH=runtime/securemesh.db
SECUREMESH_CA_CERT_PATH=runtime/ca/ca.crt.pem
# Offline provisioning only; the server never reads this setting.
SECUREMESH_CA_KEY_PATH=runtime/ca/ca.key.pem
SECUREMESH_SERVER_HOST=127.0.0.1
SECUREMESH_SERVER_PORT=8000
SECUREMESH_MQTT_HOST=127.0.0.1
SECUREMESH_MQTT_PORT=1883
SECUREMESH_MQTT_ENABLED=true
# setup_broker writes MQTT credentials to ignored runtime/mqtt/client.env.
# Optional overrides: SECUREMESH_MQTT_USERNAME and SECUREMESH_MQTT_PASSWORD
SECUREMESH_SERVER_IDENTITY=control-center
SECUREMESH_SERVER_CERT_PATH=runtime/server/server.crt.pem
SECUREMESH_SERVER_KEY_PATH=runtime/server/server.key.pem
SECUREMESH_SESSION_TTL_SECONDS=600
SECUREMESH_HANDSHAKE_TTL_SECONDS=15
SECUREMESH_MAX_CLOCK_SKEW_SECONDS=5
SECUREMESH_TELEMETRY_MAX_AGE_SECONDS=30
SECUREMESH_MAX_MESSAGES_PER_SESSION=100000
SECUREMESH_MAX_PENDING_HANDSHAKES=128
SECUREMESH_REPLAY_POLICY=strict_monotonic
